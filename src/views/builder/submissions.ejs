<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= project.name %> — Form Leads & Submissions</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
  <style>body { font-family: 'Inter', system-ui, sans-serif; }</style>
</head>
<body class="min-h-screen bg-[#0a0b10] text-gray-100 flex flex-col">

<!-- Top Nav -->
<header class="border-b border-white/[0.08] bg-[#10121a] sticky top-0 z-30">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/builder/dashboard" class="text-gray-400 hover:text-white transition-colors flex items-center gap-1.5 text-xs font-semibold">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Dashboard
      </a>
      <span class="text-gray-600">/</span>
      <span class="font-bold text-white text-sm"><%= project.name %></span>
      <span class="text-xs text-violet-400 font-mono bg-violet-500/10 px-2 py-0.5 rounded border border-violet-500/20">Leads & Inquiries</span>
    </div>

    <div class="flex items-center gap-2">
      <a href="/builder/editor/<%= project._id || project.id %>"
        class="px-4 py-2 bg-violet-600 hover:bg-violet-500 text-white rounded-lg text-xs font-semibold transition-all">
        Open Editor
      </a>
    </div>
  </div>
</header>

<main class="max-w-7xl mx-auto px-6 py-10 flex-1 w-full">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-extrabold text-white">Form Submissions & Leads</h1>
      <p class="text-gray-400 text-xs mt-1">Real-time incoming form entries from interactive forms on this site.</p>
    </div>
    <div class="text-xs text-gray-400 font-mono">
      Total Entries: <span class="text-white font-bold"><%= submissions ? submissions.length : 0 %></span>
    </div>
  </div>

  <% if (!submissions || submissions.length === 0) { %>
  <div class="border border-dashed border-white/10 rounded-2xl p-16 text-center bg-[#10121a]/50">
    <div class="w-12 h-12 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-3 text-gray-400">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
    </div>
    <p class="text-sm font-semibold text-gray-300">No form submissions received yet</p>
    <p class="text-xs text-gray-500 mt-1 max-w-sm mx-auto">When visitors fill in contact forms or inquiry forms on your site, entries will appear here instantly.</p>
  </div>
  <% } else { %>
  <div class="bg-[#11131a] border border-white/[0.08] rounded-xl overflow-hidden shadow-xl">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-[#161824] text-gray-400 font-semibold border-b border-white/[0.06]">
          <tr>
            <th class="p-4">Form</th>
            <th class="p-4">Date</th>
            <th class="p-4">Submitted Data</th>
            <th class="p-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/[0.04]">
          <% submissions.forEach(function(sub) { %>
          <tr class="hover:bg-white/[0.02] transition-colors" id="sub-row-<%= sub._id || sub.id %>">
            <td class="p-4 font-semibold text-violet-300 whitespace-nowrap"><%= sub.formName %></td>
            <td class="p-4 text-gray-400 whitespace-nowrap"><%= new Date(sub.createdAt).toLocaleString() %></td>
            <td class="p-4">
              <div class="space-y-1">
                <% Object.entries(sub.data || {}).forEach(function([k, v]) { %>
                  <div class="text-[11px]"><span class="text-gray-400 font-mono"><%= k %>:</span> <span class="text-gray-200"><%= v %></span></div>
                <% }); %>
              </div>
            </td>
            <td class="p-4 text-right">
              <button onclick="deleteSubmission('<%= sub._id || sub.id %>')" class="p-1.5 text-gray-500 hover:text-red-400 rounded transition-colors" title="Delete entry">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              </button>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>
</main>

<script>
async function deleteSubmission(id) {
  if (!confirm("Delete this submission entry?")) return;
  try {
    const res = await fetch(`/api/forms/submissions/${id}`, { method: "DELETE" });
    if (res.ok) {
      document.getElementById(`sub-row-${id}`)?.remove();
    }
  } catch (err) {
    alert("Could not delete");
  }
}
</script>
</body>
</html>
