<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= project.name %> — NodeCanvas Builder</title>

  <!-- Tailwind CSS via unpkg (already in CSP allowlist) -->
  <script src="https://unpkg.com/@tailwindcss/browser@4"></script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- HTMX v2 -->
  <script src="https://unpkg.com/htmx.org@2.0.3/dist/htmx.min.js"></script>
  <!-- HTMX v2 extensions (correct URLs) -->
  <script src="https://unpkg.com/htmx-ext-ws@2.0.2/ws.js"></script>

  <!-- SortableJS -->
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

  <!-- Builder custom styles -->
  <link rel="stylesheet" href="/builder/builder.css" />

  <!-- Tailwind CSS via CDN (no build step required) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            inter: ["Inter", "system-ui", "sans-serif"],
            mono:  ["JetBrains Mono", "monospace"],
          },
        }
      }
    }
  </script>
  <!-- Builder custom component styles -->
  <link rel="stylesheet" href="/builder/builder.css" />
</head>

<body
  class="h-full bg-[#0f1117] text-gray-100 overflow-hidden select-none"
  style="font-family:'Inter',system-ui,sans-serif"
  hx-ext="ws"
  ws-connect="/ws?project=<%= project._id %>"
>

<!-- Real project/page IDs for JS to read -->
<meta name="nc-project-id" content="<%= project._id %>" />
<meta name="nc-page-id"    content="<%= page ? page._id : '' %>" />

<!-- ══════════════════════════════════════════════════════════════════════
     TOP TOOLBAR
══════════════════════════════════════════════════════════════════════ -->
<header class="flex items-center justify-between h-12 bg-[#1a1d27] border-b border-white/[0.06] px-4 z-50 relative shrink-0" style="flex-shrink:0">

  <!-- Left: Logo + Project Name -->
  <div class="flex items-center gap-4">
    <div class="flex items-center gap-2">
      <svg class="w-6 h-6 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" />
      </svg>
      <a href="/builder/dashboard" class="font-semibold text-sm text-white hover:text-violet-400 transition-colors">NodeCanvas</a>
    </div>
    <div class="w-px h-5 bg-white/10"></div>
    <input id="project-name" type="text" value="<%= project.name %>"
      class="bg-transparent text-sm text-gray-300 border-none outline-none focus:text-white transition-colors w-44"
      hx-post="/api/projects/<%= project._id %>/rename"
      hx-trigger="change" hx-include="this" name="name" />
  </div>

  <!-- Center: Viewport Controls -->
  <div class="flex items-center gap-1 bg-[#12141f] rounded-lg p-1">
    <button data-viewport="desktop" id="vp-desktop"
      class="viewport-btn active flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-medium transition-all"
      onclick="setViewport('desktop')">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      Desktop
    </button>
    <button data-viewport="tablet" id="vp-tablet"
      class="viewport-btn flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-medium text-gray-400 transition-all hover:text-white"
      onclick="setViewport('tablet')">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
      Tablet
    </button>
    <button data-viewport="mobile" id="vp-mobile"
      class="viewport-btn flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-medium text-gray-400 transition-all hover:text-white"
      onclick="setViewport('mobile')">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
      Mobile
    </button>
  </div>

  <!-- Right: Undo/Redo / Preview / Export / Save -->
  <div class="flex items-center gap-2">
    <button id="btn-undo" title="Undo (Ctrl+Z)"
      class="p-1.5 rounded hover:bg-white/10 text-gray-400 hover:text-white transition-all" disabled>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
    </button>
    <button id="btn-redo" title="Redo (Ctrl+Y)"
      class="p-1.5 rounded hover:bg-white/10 text-gray-400 hover:text-white transition-all" disabled>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 10H11a8 8 0 00-8 8v2M21 10l-6 6m6-6l-6-6"/></svg>
    </button>

    <div class="w-px h-5 bg-white/10 mx-1"></div>

    <a href="/builder/preview/<%= project._id %>/<%= page ? page._id : '' %>" target="_blank"
      class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium text-gray-300 hover:bg-white/10 transition-all">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
      Preview
    </a>

    <!-- Export Dropdown -->
    <div class="relative" id="export-menu-wrapper">
      <button id="export-toggle"
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium text-gray-300 hover:bg-white/10 transition-all">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
        Export
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </button>
      <div id="export-menu" class="hidden absolute right-0 top-full mt-1 w-52 bg-[#1e2130] border border-white/10 rounded-lg shadow-2xl z-50 py-1">
        <button class="w-full px-4 py-2 text-xs text-left text-gray-300 hover:bg-white/10 hover:text-white flex items-center gap-2"
          hx-post="/api/export/<%= project._id %>/static"
          hx-target="#export-status" hx-swap="innerHTML">
          <svg class="w-3.5 h-3.5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Static HTML / CSS / JS
        </button>
        <button class="w-full px-4 py-2 text-xs text-left text-gray-300 hover:bg-white/10 hover:text-white flex items-center gap-2"
          hx-post="/api/export/<%= project._id %>/wordpress"
          hx-target="#export-status" hx-swap="innerHTML">
          <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          WordPress Theme
        </button>
        <button class="w-full px-4 py-2 text-xs text-left text-gray-300 hover:bg-white/10 hover:text-white flex items-center gap-2"
          hx-post="/api/export/<%= project._id %>/json"
          hx-target="#export-status" hx-swap="innerHTML">
          <svg class="w-3.5 h-3.5 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          Project JSON
        </button>
      </div>
    </div>

    <!-- Save button -->
    <button id="btn-save"
      class="flex items-center gap-1.5 px-4 py-1.5 bg-violet-600 hover:bg-violet-500 rounded-md text-xs font-semibold text-white transition-all">
      <svg id="save-icon" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
      Save
    </button>
  </div>
</header>

<!-- Page tabs bar (multipage) -->
<div id="page-tabs-bar"
  class="flex items-center gap-1 px-4 py-1.5 bg-[#15182A] border-b border-white/[0.04]"
  style="min-height:36px; flex-shrink:0">

  <!-- Existing pages injected here -->
  <% if (project.pages && project.pages.length) { %>
    <% project.pages.forEach(function(p) {
      const isActive = page && p._id.toString() === page._id.toString();
    %>
    <div class="page-tab-item flex items-center gap-1 group" data-page-id="<%= p._id %>">
      <a href="/builder/editor/<%= project._id %>/<%= p._id %>"
         class="flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-medium transition-all <%= isActive ? 'bg-violet-600/30 text-violet-300' : 'text-gray-400 hover:text-white hover:bg-white/5' %>">
        <% if (p.isHomepage) { %>
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        <% } else { %>
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <% } %>
        <%= p.name %>
      </a>
      <button class="rename-page-btn opacity-0 group-hover:opacity-100 p-0.5 text-gray-600 hover:text-gray-300 transition-all"
        data-page-id="<%= p._id %>" data-page-name="<%= p.name %>" title="Rename">
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      </button>
      <% if (!p.isHomepage) { %>
      <button class="delete-page-btn opacity-0 group-hover:opacity-100 p-0.5 text-gray-600 hover:text-red-400 transition-all"
        data-page-id="<%= p._id %>" data-project-id="<%= project._id %>" title="Delete page">
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <% } %>
    </div>
    <% }); %>
  <% } %>

  <!-- Add new page button -->
  <button id="btn-add-page"
    class="flex items-center gap-1 px-2 py-1 text-xs text-gray-500 hover:text-violet-400 rounded transition-all ml-1"
    title="Add new page">
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    Add Page
  </button>
</div>

<!-- ══════════════════════════════════════════════════════════════════════
     MAIN BUILDER LAYOUT
══════════════════════════════════════════════════════════════════════ -->
<div class="flex overflow-hidden" style="height:calc(100vh - 84px)">

  <!-- ── LEFT SIDEBAR ─────────────────────────────────────────────────── -->
  <aside class="flex flex-col bg-[#1a1d27] border-r border-white/[0.06]" style="width:256px;flex-shrink:0">
    <div class="flex border-b border-white/[0.06]" style="flex-shrink:0">
      <button class="left-tab active flex-1 py-2.5 text-xs font-medium" data-tab="elements" id="ltab-elements">Elements</button>
      <button class="left-tab flex-1 py-2.5 text-xs font-medium text-gray-500" data-tab="layers" id="ltab-layers">Layers</button>
      <button class="left-tab flex-1 py-2.5 text-xs font-medium text-gray-500" data-tab="templates" id="ltab-templates">Templates</button>
    </div>

    <!-- Elements Tab -->
    <div id="tab-elements" class="flex-1 overflow-y-auto p-3 space-y-4">
      <input type="text" id="element-search" placeholder="Search elements…"
        class="w-full bg-[#12141f] text-xs text-gray-300 px-3 py-2 rounded-lg border border-white/[0.06] outline-none"
        style="transition:border-color .15s" />
      <div class="space-y-4" id="element-groups">
        <!-- Populated by elementLibrary.js -->
      </div>
    </div>

    <!-- Layers Tab -->
    <div id="tab-layers" class="hidden flex-1 overflow-y-auto p-3">
      <div id="layers-tree">
        <p class="text-xs text-gray-600 text-center mt-8">Drop elements onto the canvas to see layers.</p>
      </div>
    </div>

    <!-- Templates Tab -->
    <div id="tab-templates" class="hidden flex-1 overflow-y-auto p-3">
      <div id="templates-grid" class="grid grid-cols-1 gap-3"
        hx-get="/builder/templates" hx-trigger="intersect once" hx-swap="innerHTML">
        <p class="text-xs text-gray-600 text-center py-8">Loading templates…</p>
      </div>
    </div>
  </aside>

  <!-- ── CANVAS AREA ─────────────────────────────────────────────────── -->
  <main class="flex-1 overflow-auto bg-[#0f1117] flex flex-col items-center" style="background:radial-gradient(ellipse at center,#1a1d27 0%,#0f1117 100%)">
    <div id="canvas-frame-container" class="relative mt-8 mb-16 transition-all duration-300" style="width:1280px">
      <div class="flex justify-between text-gray-700 mb-1 px-1" style="font-size:9px;font-family:monospace">
        <span>0</span><span>320</span><span>640</span><span>960</span><span>1280px</span>
      </div>
      <div id="canvas" class="bg-white min-h-screen relative shadow-2xl"
        style="box-shadow:0 25px 50px rgba(0,0,0,0.6)">
        <div id="canvas-empty-hint" class="flex flex-col items-center justify-center" style="height:400px;color:#9ca3af;pointer-events:none">
          <svg class="w-12 h-12 mb-3" style="opacity:.3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 4v16m8-8H4"/>
          </svg>
          <p style="font-size:14px;opacity:.5">Drag elements here to start building</p>
        </div>
      </div>
    </div>
  </main>

  <!-- ── RIGHT PANEL ─────────────────────────────────────────────────── -->
  <aside class="flex flex-col bg-[#1a1d27] border-l border-white/[0.06]" style="width:288px;flex-shrink:0;overflow:hidden">

    <!-- Empty state -->
    <div id="panel-empty" class="flex-1 flex flex-col items-center justify-center text-center px-6">
      <svg class="w-10 h-10 text-gray-700 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5"/>
      </svg>
      <p class="text-xs text-gray-600">Select an element to edit properties</p>
    </div>

    <!-- Properties (shown on selection) -->
    <div id="panel-properties" class="hidden flex-col overflow-hidden" style="display:none">
      <!-- Element badge + delete -->
      <div class="px-4 py-3 border-b border-white/[0.06] flex items-center justify-between" style="flex-shrink:0">
        <div class="flex items-center gap-2">
          <span id="selected-tag-badge" class="px-1.5 py-0.5 rounded text-violet-300" style="background:rgba(124,58,237,.3);font-size:10px;font-family:monospace">DIV</span>
          <input id="selected-id" type="text" placeholder="#id" class="text-xs text-gray-400 bg-transparent border-none outline-none w-24 font-mono" />
        </div>
        <button id="btn-delete-el" class="p-1 rounded text-gray-600 hover:text-red-400 transition-all" title="Delete element">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </button>
      </div>

      <!-- Property tabs -->
      <div class="flex border-b border-white/[0.06]" style="flex-shrink:0;font-size:10px">
        <button class="prop-tab active flex-1 py-2 font-medium" data-ptab="style" id="ptab-btn-style">Style</button>
        <button class="prop-tab flex-1 py-2 font-medium text-gray-500" data-ptab="content" id="ptab-btn-content">Content</button>
        <button class="prop-tab flex-1 py-2 font-medium text-gray-500" data-ptab="htmx" id="ptab-btn-htmx">HTMX</button>
        <button class="prop-tab flex-1 py-2 font-medium text-gray-500" data-ptab="anim" id="ptab-btn-anim">Anim</button>
      </div>

      <div class="flex-1 overflow-y-auto">
        <!-- Style Tab -->
        <div id="ptab-style" class="p-4 space-y-5">

          <div class="space-y-2">
            <p class="prop-section-title">Layout</p>
            <div class="grid grid-cols-2 gap-2">
              <div><label class="prop-label">Display</label>
                <select class="prop-select" id="sp-display"><option value="block">block</option><option value="flex">flex</option><option value="grid">grid</option><option value="inline-block">inline-block</option><option value="inline">inline</option><option value="none">none</option></select></div>
              <div><label class="prop-label">Position</label>
                <select class="prop-select" id="sp-position"><option value="static">static</option><option value="relative">relative</option><option value="absolute">absolute</option><option value="fixed">fixed</option><option value="sticky">sticky</option></select></div>
            </div>
            <!-- Flex controls -->
            <div id="flex-controls" class="space-y-2 hidden">
              <div class="grid grid-cols-2 gap-2">
                <div><label class="prop-label">Direction</label>
                  <select class="prop-select" id="sp-flex-direction"><option value="row">Row</option><option value="row-reverse">Row Rev</option><option value="column">Column</option><option value="column-reverse">Col Rev</option></select></div>
                <div><label class="prop-label">Wrap</label>
                  <select class="prop-select" id="sp-flex-wrap"><option value="nowrap">No Wrap</option><option value="wrap">Wrap</option></select></div>
              </div>
              <div><label class="prop-label">Justify Content</label>
                <select class="prop-select" id="sp-justify"><option value="flex-start">flex-start</option><option value="center">center</option><option value="flex-end">flex-end</option><option value="space-between">space-between</option><option value="space-around">space-around</option></select></div>
              <div><label class="prop-label">Align Items</label>
                <select class="prop-select" id="sp-align"><option value="stretch">stretch</option><option value="flex-start">flex-start</option><option value="center">center</option><option value="flex-end">flex-end</option></select></div>
              <div><label class="prop-label">Gap</label><input type="text" class="prop-input" id="sp-gap" placeholder="0px" /></div>
            </div>
          </div>

          <div class="space-y-2">
            <p class="prop-section-title">Box Model</p>
            <div class="grid grid-cols-2 gap-2">
              <div><label class="prop-label">Width</label><input type="text" class="prop-input" id="sp-width" placeholder="auto" /></div>
              <div><label class="prop-label">Height</label><input type="text" class="prop-input" id="sp-height" placeholder="auto" /></div>
              <div><label class="prop-label">Min-W</label><input type="text" class="prop-input" id="sp-minw" placeholder="0" /></div>
              <div><label class="prop-label">Max-W</label><input type="text" class="prop-input" id="sp-maxw" placeholder="none" /></div>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div><label class="prop-label">Padding</label><input type="text" class="prop-input" id="sp-padding" placeholder="0px" /></div>
              <div><label class="prop-label">Margin</label><input type="text" class="prop-input" id="sp-margin" placeholder="0px" /></div>
            </div>
          </div>

          <div class="space-y-2">
            <p class="prop-section-title">Typography</p>
            <div><label class="prop-label">Font Family</label>
              <select class="prop-select" id="sp-font-family">
                <option value="">Inherit</option><option value="'Inter',sans-serif">Inter</option>
                <option value="'Georgia',serif">Georgia</option><option value="'Arial',sans-serif">Arial</option>
                <option value="'Courier New',monospace">Courier New</option><option value="system-ui,sans-serif">System UI</option>
              </select></div>
            <div class="grid grid-cols-2 gap-2">
              <div><label class="prop-label">Size</label><input type="text" class="prop-input" id="sp-font-size" placeholder="16px" /></div>
              <div><label class="prop-label">Weight</label>
                <select class="prop-select" id="sp-font-weight"><option value="300">Light</option><option value="400">Regular</option><option value="500">Medium</option><option value="600">Semi</option><option value="700">Bold</option><option value="900">Black</option></select></div>
              <div><label class="prop-label">Line Height</label><input type="text" class="prop-input" id="sp-line-height" placeholder="1.5" /></div>
              <div><label class="prop-label">Letter Spacing</label><input type="text" class="prop-input" id="sp-letter-spacing" placeholder="0em" /></div>
            </div>
            <div><label class="prop-label">Text Align</label>
              <div class="flex gap-1">
                <button class="flex-align-btn" id="ta-left">L</button><button class="flex-align-btn" id="ta-center">C</button>
                <button class="flex-align-btn" id="ta-right">R</button><button class="flex-align-btn" id="ta-justify">J</button>
              </div></div>
            <div><label class="prop-label">Color</label>
              <div class="flex gap-2">
                <input type="color" class="rounded cursor-pointer border border-white/10 bg-transparent" id="sp-color" style="width:32px;height:32px" />
                <input type="text" class="prop-input flex-1" id="sp-color-hex" placeholder="#000000" />
              </div></div>
          </div>

          <div class="space-y-2">
            <p class="prop-section-title">Background</p>
            <div><label class="prop-label">Type</label>
              <select class="prop-select" id="sp-bg-type"><option value="none">None</option><option value="color">Solid Color</option><option value="gradient">Gradient</option></select></div>
            <div id="bg-color-ctrl" class="hidden flex gap-2">
              <input type="color" class="rounded border border-white/10" id="sp-bg-color" style="width:32px;height:32px" />
              <input type="text" class="prop-input flex-1" id="sp-bg-color-hex" placeholder="#ffffff" />
            </div>
            <div id="bg-gradient-ctrl" class="hidden space-y-2">
              <div class="grid grid-cols-2 gap-2">
                <div><label class="prop-label">Color 1</label><input type="color" class="w-full rounded border border-white/10" id="grad-c1" style="height:28px" /></div>
                <div><label class="prop-label">Color 2</label><input type="color" class="w-full rounded border border-white/10" id="grad-c2" style="height:28px" value="#9333ea" /></div>
              </div>
              <div><label class="prop-label">Angle</label><input type="range" min="0" max="360" value="135" class="w-full" id="grad-angle" /></div>
            </div>
          </div>

          <div class="space-y-2">
            <p class="prop-section-title">Border & Effects</p>
            <div class="grid grid-cols-3 gap-2">
              <div><label class="prop-label">Width</label><input type="text" class="prop-input" id="sp-border-width" placeholder="0px" /></div>
              <div><label class="prop-label">Style</label>
                <select class="prop-select" id="sp-border-style"><option value="none">none</option><option value="solid">solid</option><option value="dashed">dashed</option><option value="dotted">dotted</option></select></div>
              <div><label class="prop-label">Color</label><input type="color" class="w-full rounded border border-white/10" id="sp-border-color" style="height:28px" /></div>
            </div>
            <div><label class="prop-label">Border Radius</label><input type="text" class="prop-input" id="sp-border-radius" placeholder="0px" /></div>
            <div><label class="prop-label">Box Shadow</label><input type="text" class="prop-input" id="sp-box-shadow" placeholder="0 4px 12px rgba(0,0,0,0.1)" /></div>
            <div><label class="prop-label">Opacity</label><input type="range" min="0" max="100" value="100" class="w-full" id="sp-opacity" /></div>
            <div><label class="prop-label">Filter</label><input type="text" class="prop-input" id="sp-filter" placeholder="blur(0px)" /></div>
          </div>
        </div>

        <!-- Content Tab -->
        <div id="ptab-content" class="hidden p-4 space-y-4">
          <div><label class="prop-label">Inner Text</label>
            <textarea id="sp-innertext" rows="4" class="prop-input" style="resize:vertical;height:auto" placeholder="Element text content"></textarea></div>
          <div><label class="prop-label">CSS Classes</label>
            <input type="text" id="sp-classes" class="prop-input" placeholder="class1 class2" /></div>
          <div><label class="prop-label">Custom Attrs (JSON)</label>
            <textarea id="sp-attrs" rows="3" class="prop-input" style="resize:vertical;height:auto" placeholder='{"data-key":"value"}'></textarea></div>
          <div><label class="prop-label">innerHTML (raw HTML)</label>
            <textarea id="sp-innerhtml" rows="5" class="prop-input" style="resize:vertical;height:auto" placeholder="<span>Raw HTML</span>"></textarea></div>
        </div>

        <!-- HTMX Tab -->
        <div id="ptab-htmx" class="hidden p-4 space-y-4">
          <p class="text-xs text-gray-500">Configure HTMX without writing code.</p>
          <div><label class="prop-label">hx-trigger</label>
            <select class="prop-select" id="sp-hx-trigger">
              <option value="">— none —</option><option value="click">click</option><option value="change">change</option>
              <option value="submit">submit</option><option value="mouseover">mouseover</option>
              <option value="keyup changed delay:300ms">keyup (debounced)</option>
              <option value="load">load</option><option value="revealed">scroll into view</option>
            </select></div>
          <div><label class="prop-label">Method</label>
            <div class="flex gap-1">
              <button class="htmx-method-btn active" data-method="hx-get">GET</button>
              <button class="htmx-method-btn" data-method="hx-post">POST</button>
              <button class="htmx-method-btn" data-method="hx-put">PUT</button>
              <button class="htmx-method-btn" data-method="hx-delete">DEL</button>
            </div></div>
          <div><label class="prop-label">Endpoint URL</label><input type="text" class="prop-input" id="sp-hx-url" placeholder="/api/endpoint" /></div>
          <div><label class="prop-label">hx-target</label><input type="text" class="prop-input" id="sp-hx-target" placeholder="#result-div" /></div>
          <div><label class="prop-label">hx-swap</label>
            <select class="prop-select" id="sp-hx-swap">
              <option value="innerHTML">innerHTML</option><option value="outerHTML">outerHTML</option>
              <option value="beforeend">beforeend</option><option value="afterend">afterend</option><option value="none">none</option>
            </select></div>
          <div class="border-t border-white/[0.06] pt-4 space-y-2">
            <p class="prop-section-title">Conditional Logic</p>
            <div><label class="prop-label">On Success → Show</label><input type="text" class="prop-input" id="sp-success-show" placeholder="#success-msg" /></div>
            <div><label class="prop-label">On Success → Hide</label><input type="text" class="prop-input" id="sp-success-hide" placeholder="#the-form" /></div>
            <div><label class="prop-label">On Error → Show</label><input type="text" class="prop-input" id="sp-error-show" placeholder="#error-msg" /></div>
          </div>
        </div>

        <!-- Animation Tab -->
        <div id="ptab-anim" class="hidden p-4 space-y-4">
          <div><label class="prop-label">Preset</label>
            <select class="prop-select" id="sp-anim-preset">
              <option value="">— none —</option><option value="fadeIn">Fade In</option><option value="fadeOut">Fade Out</option>
              <option value="slideInLeft">Slide In Left</option><option value="slideInRight">Slide In Right</option>
              <option value="slideInUp">Slide In Up</option><option value="slideInDown">Slide In Down</option>
              <option value="zoomIn">Zoom In</option><option value="zoomOut">Zoom Out</option>
              <option value="bounce">Bounce</option><option value="pulse">Pulse</option><option value="shake">Shake</option>
            </select></div>
          <div class="grid grid-cols-2 gap-2">
            <div><label class="prop-label">Duration</label><input type="text" class="prop-input" id="sp-anim-dur" placeholder="0.5s" /></div>
            <div><label class="prop-label">Delay</label><input type="text" class="prop-input" id="sp-anim-delay" placeholder="0s" /></div>
          </div>
          <div><label class="prop-label">Easing</label>
            <select class="prop-select" id="sp-anim-ease">
              <option value="ease">ease</option><option value="ease-in">ease-in</option><option value="ease-out">ease-out</option>
              <option value="ease-in-out">ease-in-out</option><option value="linear">linear</option>
            </select></div>
          <div><label class="prop-label">Trigger</label>
            <select class="prop-select" id="sp-anim-trigger">
              <option value="load">Page Load</option><option value="scroll">Scroll Into View</option>
              <option value="hover">Hover</option><option value="click">Click</option>
            </select></div>
          <div><label class="prop-label">Iteration</label>
            <select class="prop-select" id="sp-anim-iter">
              <option value="1">Once</option><option value="2">2×</option><option value="3">3×</option><option value="infinite">Infinite</option>
            </select></div>
        </div>
      </div>
    </div>
  </aside>
</div>

<!-- Media Picker Modal -->
<div id="media-modal" class="hidden fixed inset-0 z-[100] flex items-center justify-center" style="background:rgba(0,0,0,.7);backdrop-filter:blur(4px)">
  <div class="bg-[#1a1d27] border border-white/10 rounded-xl shadow-2xl flex flex-col" style="width:680px;max-height:80vh">
    <div class="flex items-center justify-between px-5 py-4 border-b border-white/[0.06]">
      <h2 class="text-sm font-semibold">Media Library</h2>
      <div class="flex items-center gap-3">
        <label class="cursor-pointer flex items-center gap-2 px-3 py-1.5 bg-violet-600 hover:bg-violet-500 rounded-md text-xs font-medium transition-all">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
          Upload
          <input type="file" class="hidden" multiple accept="image/*,video/*"
            hx-post="/api/media/upload" hx-encoding="multipart/form-data"
            hx-target="#media-grid" hx-swap="afterbegin" name="files" />
        </label>
        <button id="media-modal-close" class="text-gray-400 hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
    <div id="media-grid" class="flex-1 overflow-y-auto p-4 grid grid-cols-4 gap-3"
      hx-get="/api/media/list" hx-trigger="intersect once">
    </div>
  </div>
</div>

<!-- Context Menu -->
<div id="context-menu" class="hidden fixed z-[300] bg-[#1e2130] border border-white/10 rounded-lg shadow-2xl py-1" style="width:192px;font-size:12px">
  <button class="ctx-btn w-full text-left px-4 py-2 hover:bg-white/10 transition-colors" data-action="duplicate">Duplicate</button>
  <button class="ctx-btn w-full text-left px-4 py-2 hover:bg-white/10 transition-colors" data-action="copy-style">Copy Style</button>
  <button class="ctx-btn w-full text-left px-4 py-2 hover:bg-white/10 transition-colors" data-action="paste-style">Paste Style</button>
  <button class="ctx-btn w-full text-left px-4 py-2 hover:bg-white/10 transition-colors" data-action="wrap-div">Wrap in Div</button>
  <div class="h-px bg-white/10 my-1"></div>
  <button class="ctx-btn w-full text-left px-4 py-2 hover:bg-white/10 transition-colors" data-action="move-up">Move Up</button>
  <button class="ctx-btn w-full text-left px-4 py-2 hover:bg-white/10 transition-colors" data-action="move-down">Move Down</button>
  <div class="h-px bg-white/10 my-1"></div>
  <button class="ctx-btn w-full text-left px-4 py-2 text-red-400 hover:bg-red-500/20 transition-colors" data-action="delete">Delete</button>
</div>

<!-- Export status toast -->
<div id="export-status" class="fixed bottom-6 right-6 z-[200]"></div>

<!-- Inject project/page IDs as JS constants (no inline handlers) -->
<script>
  window.NC_PROJECT_ID = "<%= project._id %>";
  window.NC_PAGE_ID    = "<%= page ? page._id : '' %>";
  window.NC_PAGE_DATA  = <%- pageJson || 'null' %>;
</script>

<!-- Builder JS modules -->
<script type="module" src="/builder/js/main.js"></script>

</body>
</html>