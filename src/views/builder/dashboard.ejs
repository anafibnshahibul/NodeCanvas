<!DOCTYPE html>
<html lang="en" class="h-full bg-[#0f1117]">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NodeCanvas — Dashboard</title>
  <!-- Tailwind CSS via CDN (no build step required) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            inter: ["Inter", "system-ui", "sans-serif"],
            mono:  ["JetBrains Mono", "monospace"],
          },
        }
      }
    }
  </script>
  <!-- Builder custom component styles -->
  <link rel="stylesheet" href="/builder/builder.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <script src="https://unpkg.com/htmx.org@2.0.3/dist/htmx.min.js" defer></script>
</head>
<body class="h-full text-gray-100 font-inter">

<div class="min-h-screen bg-[#0f1117]">
  <!-- Header -->
  <header class="border-b border-white/[0.06] bg-[#1a1d27]">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <svg class="w-7 h-7 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/>
        </svg>
        <span class="text-lg font-bold">NodeCanvas</span>
      </div>
      <button
        hx-post="/api/projects"
        hx-vals='{"name":"Untitled Project"}'
        hx-on::after-request="window.location.href='/builder/editor/' + JSON.parse(event.detail.xhr.response).project._id"
        class="flex items-center gap-2 px-4 py-2 bg-violet-600 hover:bg-violet-500 rounded-lg text-sm font-semibold transition-all">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        New Project
      </button>
    </div>
  </header>

  <!-- Project Grid -->
  <main class="max-w-6xl mx-auto px-6 py-10">
    <h1 class="text-2xl font-bold mb-2">Your Projects</h1>
    <p class="text-gray-500 text-sm mb-8"><%= projects.length %> project<%= projects.length !== 1 ? "s" : "" %></p>

    <% if (projects.length === 0) { %>
      <div class="text-center py-24 border border-dashed border-white/10 rounded-2xl">
        <svg class="w-12 h-12 text-gray-700 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <p class="text-gray-500 text-sm mb-4">No projects yet. Create your first one!</p>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        <% projects.forEach(project => { %>
        <a href="/builder/editor/<%= project._id %>"
          class="group block bg-[#1a1d27] border border-white/[0.06] rounded-xl overflow-hidden hover:border-violet-500/40 transition-all">
          <!-- Thumbnail -->
          <div class="aspect-[4/3] bg-[#12141f] overflow-hidden">
            <% if (project.thumbnail) { %>
              <img src="<%= project.thumbnail %>" alt="<%= project.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            <% } else { %>
              <div class="flex items-center justify-center h-full">
                <svg class="w-10 h-10 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/>
                </svg>
              </div>
            <% } %>
          </div>
          <!-- Info -->
          <div class="p-4 flex items-start justify-between">
            <div>
              <p class="font-medium text-sm text-white group-hover:text-violet-300 transition-colors"><%= project.name %></p>
              <p class="text-[11px] text-gray-600 mt-0.5">
                Updated <%= new Date(project.updatedAt).toLocaleDateString() %>
              </p>
            </div>
            <button
              onclick="event.preventDefault(); event.stopPropagation(); deleteProject('<%= project._id %>', this)"
              class="opacity-0 group-hover:opacity-100 p-1 text-gray-600 hover:text-red-400 transition-all"
              title="Delete project">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        </a>
        <% }) %>
      </div>
    <% } %>
  </main>
</div>

<script>
async function deleteProject(id, btn) {
  if (!confirm("Delete this project? This cannot be undone.")) return;
  await fetch(`/api/projects/${id}`, { method: "DELETE" });
  btn.closest("a").remove();
}
</script>
</body>
</html>