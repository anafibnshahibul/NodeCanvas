<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>NodeCanvas — Dashboard</title>
  <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <script src="https://unpkg.com/htmx.org@2.0.3/dist/htmx.min.js"></script>
  <style>
    body { font-family: 'Inter', system-ui, sans-serif; }
    .project-card:hover .card-thumb { transform: scale(1.04); }
  </style>
</head>
<body class="min-h-screen bg-[#0a0b0f] text-gray-100">

<!-- Top Nav -->
<header class="border-b border-white/[0.06] bg-[#111318] sticky top-0 z-10">
  <div class="max-w-7xl mx-auto px-6 h-14 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 bg-violet-600 rounded-lg flex items-center justify-center">
        <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>
      </div>
      <span class="font-bold text-white">NodeCanvas</span>
    </div>
    <button id="btn-new-project"
      class="flex items-center gap-2 px-4 py-2 bg-violet-600 hover:bg-violet-500 rounded-lg text-sm font-semibold transition-all shadow-lg shadow-violet-600/20">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      New Project
    </button>
  </div>
</header>

<main class="max-w-7xl mx-auto px-6 py-10">

  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-white mb-1">Your Projects</h1>
    <p class="text-gray-500 text-sm"><%= projects.length %> project<%= projects.length !== 1 ? "s" : "" %></p>
  </div>

  <!-- Grid -->
  <% if (projects.length === 0) { %>
  <div class="border border-dashed border-white/10 rounded-2xl flex flex-col items-center justify-center py-32 text-center" id="empty-state">
    <div class="w-16 h-16 bg-[#1a1d27] rounded-2xl flex items-center justify-center mb-4">
      <svg class="w-8 h-8 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
    </div>
    <p class="text-gray-400 font-medium mb-2">No projects yet</p>
    <p class="text-gray-600 text-sm mb-6">Create your first project to get started</p>
    <button id="btn-new-empty" class="px-5 py-2.5 bg-violet-600 hover:bg-violet-500 rounded-lg text-sm font-semibold transition-all">
      Create Project
    </button>
  </div>
  <% } else { %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5" id="projects-grid">
    <% projects.forEach(function(project) { %>
    <div class="project-card group bg-[#111318] border border-white/[0.06] rounded-xl overflow-hidden hover:border-violet-500/40 transition-all duration-200 cursor-pointer"
         onclick="window.location='/builder/editor/<%= project._id %>'">
      <div class="aspect-[4/3] bg-[#0a0b0f] overflow-hidden relative">
        <% if (project.thumbnail) { %>
          <img src="<%= project.thumbnail %>" alt="<%= project.name %>" class="card-thumb w-full h-full object-cover transition-transform duration-300"/>
        <% } else { %>
          <div class="w-full h-full flex items-center justify-center">
            <div class="grid grid-cols-2 gap-1.5 opacity-20">
              <div class="w-8 h-8 bg-violet-500 rounded"></div>
              <div class="w-8 h-8 bg-violet-700 rounded"></div>
              <div class="w-8 h-8 bg-violet-700 rounded"></div>
              <div class="w-8 h-8 bg-violet-500 rounded"></div>
            </div>
          </div>
        <% } %>
        <!-- Hover overlay -->
        <div class="absolute inset-0 bg-violet-900/0 group-hover:bg-violet-900/20 transition-all flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100">
          <a href="/builder/editor/<%= project._id %>" onclick="event.stopPropagation()"
             class="px-3 py-1.5 bg-white text-gray-900 rounded-md text-xs font-semibold hover:bg-gray-100 transition-all">
            Edit
          </a>
          <a href="/builder/preview/<%= project._id %>" target="_blank" onclick="event.stopPropagation()"
             class="px-3 py-1.5 bg-white/20 text-white rounded-md text-xs font-semibold hover:bg-white/30 transition-all backdrop-blur-sm">
            Preview
          </a>
        </div>
      </div>
      <div class="p-4 flex items-start justify-between">
        <div class="flex-1 min-w-0">
          <p class="font-semibold text-sm text-white truncate group-hover:text-violet-300 transition-colors"><%= project.name %></p>
          <p class="text-[11px] text-gray-600 mt-0.5">Updated <%= new Date(project.updatedAt).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) %></p>
        </div>
        <button class="delete-btn opacity-0 group-hover:opacity-100 p-1.5 text-gray-600 hover:text-red-400 hover:bg-red-400/10 rounded-md transition-all ml-2"
                data-id="<%= project._id %>" title="Delete project">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </button>
      </div>
    </div>
    <% }); %>
  </div>
  <% } %>
</main>

<!-- New project name modal -->
<div id="new-project-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center" style="background:rgba(0,0,0,.7);backdrop-filter:blur(4px)">
  <div class="bg-[#111318] border border-white/10 rounded-2xl p-6 w-full max-w-md shadow-2xl">
    <h2 class="text-lg font-bold text-white mb-1">New Project</h2>
    <p class="text-gray-500 text-sm mb-5">Give your project a name to get started.</p>
    <input id="new-project-name" type="text" placeholder="My Awesome Website"
      class="w-full bg-[#0a0b0f] border border-white/10 rounded-lg px-4 py-3 text-sm text-white outline-none focus:border-violet-500/60 transition-colors mb-4"/>
    <div class="flex gap-3">
      <button id="modal-cancel" class="flex-1 py-2.5 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-all">Cancel</button>
      <button id="modal-create" class="flex-1 py-2.5 bg-violet-600 hover:bg-violet-500 rounded-lg text-sm font-semibold text-white transition-all">
        Create Project
      </button>
    </div>
  </div>
</div>

<script>
const modal    = document.getElementById("new-project-modal");
const nameInput= document.getElementById("new-project-name");

function openModal() { modal.classList.remove("hidden"); nameInput.value=""; setTimeout(()=>nameInput.focus(),50); }
function closeModal() { modal.classList.add("hidden"); }

document.getElementById("btn-new-project")?.addEventListener("click", openModal);
document.getElementById("btn-new-empty")?.addEventListener("click", openModal);
document.getElementById("modal-cancel")?.addEventListener("click", closeModal);
modal?.addEventListener("click", e => { if(e.target===modal) closeModal(); });

nameInput?.addEventListener("keydown", e => { if(e.key==="Enter") createProject(); });
document.getElementById("modal-create")?.addEventListener("click", createProject);

async function createProject() {
  const name = nameInput.value.trim() || "Untitled Project";
  const btn  = document.getElementById("modal-create");
  btn.disabled = true;
  btn.textContent = "Creating…";
  try {
    const res  = await fetch("/api/projects", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ name }),
    });
    const data = await res.json();
    if (data.project?._id) {
      window.location.href = `/builder/editor/${data.project._id}`;
    }
  } catch(e) {
    btn.disabled = false;
    btn.textContent = "Create Project";
  }
}

// Delete project
document.querySelectorAll(".delete-btn").forEach(btn => {
  btn.addEventListener("click", async e => {
    e.stopPropagation();
    if(!confirm("Delete this project? This cannot be undone.")) return;
    await fetch(`/api/projects/${btn.dataset.id}`, { method: "DELETE" });
    btn.closest(".project-card").style.opacity = "0";
    btn.closest(".project-card").style.transform = "scale(0.95)";
    btn.closest(".project-card").style.transition = "all 0.2s";
    setTimeout(() => btn.closest(".project-card").remove(), 200);
  });
});
</script>
</body>
</html>