{
  "name": "nodecanvas-builder",
  "version": "1.0.0",
  "description": "Enterprise drag-and-drop website builder — Node.js + HTMX + Tailwind",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"node --watch server.js\" \"npx @tailwindcss/cli -i ./public/builder/builder.css -o ./public/builder/builder.dist.css --watch\"",
    "build:css": "npx @tailwindcss/cli@next -i ./public/builder/builder.css -o ./public/builder/builder.dist.css --minify",
    "start": "node server.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5",
    "uuid": "^11.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^9.2.4",
    "tailwindcss": "^4.3.3"
  }
}
