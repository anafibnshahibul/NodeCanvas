# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# ── Database (choose one) ──────────────────────────────────
# MongoDB
MONGO_URI=mongodb://localhost:27017/nodecanvas

# PostgreSQL (if using Sequelize instead)
# PG_HOST=localhost
# PG_PORT=5432
# PG_DB=nodecanvas
# PG_USER=postgres
# PG_PASS=yourpassword

# ── File Storage ───────────────────────────────────────────
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
MAX_FILE_SIZE_MB=20

# ── App ────────────────────────────────────────────────────
APP_SECRET=change_this_to_a_long_random_secret
