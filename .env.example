# ── Server ────────────────────────────────────────────────
PORT=9080
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:9080

# ── JSON File Database ─────────────────────────────────────
# Data directory where JSON collections are stored atomically
DATA_DIR=./data

# ── File Storage ───────────────────────────────────────────
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
MAX_FILE_SIZE_MB=20

# ── Security & App ─────────────────────────────────────────
APP_SECRET=change_this_to_a_long_random_secret
RATE_LIMIT_MAX=1000
